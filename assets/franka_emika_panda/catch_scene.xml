<!--
  Catch task scene: Franka Panda holding a cup (panda_cup.xml) + a ball that
  is thrown toward the robot from a random spot each episode.
-->
<mujoco model="panda catch">
  <include file="panda_cup.xml"/>

  <!-- 2 ms physics steps: small enough that a fast ball can't tunnel through
       the cup walls. 25 physics steps = 1 RL step every 50 ms (20 Hz). -->
  <option timestep="0.002"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="160" elevation="-20" offwidth="1280" offheight="720"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
             rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true" castshadow="true"/>
    <light pos="1.5 1 2" dir="-0.6 -0.4 -1"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- BALL: tennis-ball sized, free to fly (6 DoF). Position and velocity are
         set from Python at the start of every episode = the "throw". -->
    <body name="ball" pos="1.8 0 1.0">
      <freejoint name="ball_joint"/>
      <geom name="ball" type="sphere" size="0.033" mass="0.057" rgba="0.85 0.95 0.2 1"
            condim="4" priority="1" friction="1 0.01 0.01"/>
    </body>
  </worldbody>
</mujoco>
